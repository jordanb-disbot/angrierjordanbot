{
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:integration": "vitest run --config vitest.integration.ts",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx scripts/seed.ts",
    "validate:commands": "tsx scripts/validate-command-registry.ts",
    "validate:config": "tsx scripts/validate-config-schema.ts",
    "validate:content": "tsx scripts/validate-content.ts",
    "validate:assets": "tsx scripts/validate-assets.ts",
    "qa": "npm run lint && npm run typecheck && npm run test && npm run validate:commands && npm run validate:config && npm run validate:content && npm run validate:assets"
  }
}