NODE_ENV=development
DISCORD_TOKEN=
DISCORD_APPLICATION_ID=
DISCORD_GUILD_ID=
DISCORD_OAUTH_CLIENT_ID=
DISCORD_OAUTH_CLIENT_SECRET=
DASHBOARD_SESSION_SECRET=
DATABASE_URL=
PUBLIC_DASHBOARD_URL=http://localhost:3000
EVIDENCE_ENCRYPTION_KEY=

# Checkpoint 02 controlled smoke gate. Leave false until dev-guild WYR validation.
ENABLE_WYR_SMOKE=false

# Checkpoint 03 onboarding/rejoin smoke gate.
ENABLE_ONBOARDING_SMOKE=false

# Checkpoint 04 moderation Hotseat smoke gate.
ENABLE_JAIL_SMOKE=false

# Checkpoint 05+ manual moderation smoke gate.
ENABLE_MODERATION_SMOKE=false

# Checkpoint 07 automated security smoke gate.
ENABLE_SECURITY_SMOKE=false

# Checkpoint 08 economy foundation smoke gate.
ENABLE_ECONOMY_SMOKE=false

# Keep disabled until Phase 09 acceptance passes. Also requires features.items in ConfigService.
ENABLE_ITEMS_SMOKE=false

# Keep disabled until profile/activity acceptance passes.
ENABLE_PROFILES_SMOKE=false

# Casino/lottery remain disabled until acceptance.
ENABLE_CASINO_SMOKE=false
