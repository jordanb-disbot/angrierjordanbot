NODE_ENV=development
DISCORD_TOKEN=
DISCORD_APPLICATION_ID=
DISCORD_GUILD_ID=
DISCORD_OAUTH_CLIENT_ID=
DISCORD_OAUTH_CLIENT_SECRET=
DASHBOARD_SESSION_SECRET=
DATABASE_URL=
PUBLIC_DASHBOARD_URL=http://localhost:3000
DISCORD_OAUTH_CALLBACK_URL=http://localhost:3000/api/auth/discord/callback
PORT=8080
AJ_DATABASE_PURPOSE=development
# Remains false until the complete authenticated dashboard is accepted.
AJ_DASHBOARD_ACCEPTED=false
# Production migration approval is set only for an explicitly approved release job.
AJ_PRODUCTION_MIGRATIONS_APPROVED=false
AJ_MIGRATION_RELEASE=
EVIDENCE_ENCRYPTION_KEY=

# Checkpoint 02 controlled smoke gate. Leave false until dev-guild WYR validation.
ENABLE_WYR_SMOKE=false

# Checkpoint 03 onboarding/rejoin smoke gate.
ENABLE_ONBOARDING_SMOKE=false

# Checkpoint 04 moderation Hotseat smoke gate.
ENABLE_JAIL_SMOKE=false

# Checkpoint 05+ manual moderation smoke gate.
ENABLE_MODERATION_SMOKE=false

# Checkpoint 07 automated security smoke gate.
ENABLE_SECURITY_SMOKE=false

# Checkpoint 08 economy foundation smoke gate.
ENABLE_ECONOMY_SMOKE=false

# Keep disabled until Phase 09 acceptance passes. Also requires features.items in ConfigService.
ENABLE_ITEMS_SMOKE=false

# Keep disabled until profile/activity acceptance passes.
ENABLE_PROFILES_SMOKE=false

# Casino/lottery remain disabled until acceptance.
ENABLE_CASINO_SMOKE=false

ENABLE_EVENTS_SMOKE=false
ENABLE_SPECIAL_SMOKE=false
ENABLE_SOLO_SMOKE=false

ENABLE_PVP_SMOKE=false

ENABLE_PARTY_SMOKE=false
ENABLE_CHANNEL_GAMES_SMOKE=false

ENABLE_CRIME_SMOKE=false

ENABLE_COMMUNITY_SMOKE=false

# Family remains disabled until Gate B and persisted-workflow acceptance.
ENABLE_FAMILY_SMOKE=false
# Stable server-side compatibility salt, at least 32 characters when Family is enabled.
# Keep the same value across restarts; never expose it in public configuration or logs.
FAMILY_COMPATIBILITY_SECRET=

ENABLE_CHAIRISMS_SMOKE=false

# Phase 22 runtime gates; server feature settings must also be enabled after acceptance.
# Lore additionally requires authentic owner-approved content; no prose ships by default.
ENABLE_SOCIAL_SMOKE=false
ENABLE_INTRODUCTIONS_SMOKE=false
ENABLE_LEARNING_SMOKE=false

# Phase 23 development acceptance only; production stays blocked until Gate C.
ENABLE_MUSIC_SMOKE=false
LAVALINK_URL=
LAVALINK_PASSWORD=
LAVALINK_ALLOW_INSECURE_HTTP=false
MUSIC_SPOTIFY_METADATA=false
MUSIC_APPLE_METADATA=false
MUSIC_DIRECT_AUDIO=false
