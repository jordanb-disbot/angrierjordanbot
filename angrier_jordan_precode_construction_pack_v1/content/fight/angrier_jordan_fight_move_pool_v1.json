{
  "version": 1,
  "feature": "robo_chair_fight",
  "command": "/fight [@member]",
  "combat_defaults": {
    "starting_hp": 100,
    "target_duration_seconds": 25,
    "target_duration_range_seconds": [
      22,
      28
    ],
    "hard_duration_cap_seconds": 30,
    "action_beat_seconds_range": [
      1.35,
      1.65
    ],
    "heal_turn_chance": 0.1,
    "attack_outcomes": {
      "normal": 0.68,
      "miss": 0.1,
      "blocked": 0.12,
      "critical": 0.1
    },
    "block_damage_multiplier_range": [
      0.25,
      0.45
    ],
    "critical_damage_multiplier_range": [
      1.65,
      1.9
    ],
    "heal_at_full_hp_behavior": "reroll_as_attack",
    "hp_min": 0,
    "hp_max": 100,
    "no_move_repeat_within_fight": true,
    "recent_move_suppression_previous_fights": 3,
    "winner_selection": "strict_50_50_preselected_before_combat_sequence",
    "sequence_generation": "sample_and_validate_until_preselected_winner_and_duration_window_are_satisfied",
    "late_fight_pacing": {
      "after_seconds": 22,
      "reduce_heal_probability": true,
      "after_seconds_2": 26,
      "disable_heals_and_misses": true,
      "purpose": "finish near target duration without changing the preselected fair winner"
    }
  },
